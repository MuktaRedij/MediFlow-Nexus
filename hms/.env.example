DEBUG=True
SECRET_KEY=replace-with-a-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ALLOW_TEST_PAYMENTS=False

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/google/callback/

EMAIL_SERVICE_URL=http://localhost:3000/dev

# Razorpay sandbox credentials (placeholders only)
RAZORPAY_KEY_ID=your-razorpay-test-key
RAZORPAY_KEY_SECRET=your-razorpay-test-secret

# Optional demo-user values for the create_demo_users command
MEDIFLOW_DEMO_ADMIN_EMAIL=your-demo-admin-email
MEDIFLOW_DEMO_ADMIN_PASSWORD=replace-with-a-demo-admin-password
MEDIFLOW_DEMO_DOCTOR_EMAIL=your-demo-doctor-email
MEDIFLOW_DEMO_DOCTOR_PASSWORD=replace-with-a-demo-doctor-password
MEDIFLOW_DEMO_PATIENT_EMAIL=your-demo-patient-email
MEDIFLOW_DEMO_PATIENT_PASSWORD=replace-with-a-demo-patient-password

# Optional Selenium login test account; set only in a local ignored .env file
MEDIFLOW_TEST_EMAIL=your-test-account-email
MEDIFLOW_TEST_PASSWORD=replace-with-a-test-account-password
